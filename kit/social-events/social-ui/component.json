{
 "id": "social-ui",
 "title": "Social list UI kit",
 "category": "social-events",
 "summary": "Off-main-thread social lists: shaped text, CA rows, the recycling list, event page chrome, the social model.",
 "description": "SocialModel wraps the world + clock for the app (every query off the main thread); SocType shapes the row text with CoreText; SocRows / SocArt / SocList draw the 200-row lists as Core Animation layers; SocChrome holds the shared event chrome; SocialEntry / SocialPopups / SocialFlows plug the event screens and popups into the shell; SocScenario presets states for captures; SocialShells is the leaderboard / event page frame. SocialLab is the debug host.",
 "status": "needs-work",
 "gaps": [
  "SocialShells / SocialModel name the home (HomeLive, HomeScene) and the profile (TopCanvas); SocialModel calls SocialFlows' hooks (events-engine, wired)."
 ],
