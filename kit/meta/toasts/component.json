   "ui.json:toast.borderWidth",
   "ui.json:toast.homeY",
   "ui.json:toast.maxWidth",
   "ui.json:toast.padX",
   "ui.json:toast.padY",
   "ui.json:toast.panelY",
   "ui.json:toast.plate",
   "ui.json:toast.plateAlpha",
   "ui.json:toast.radius"
