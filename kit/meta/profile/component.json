{
 "id": "profile",
 "title": "Profile page",
 "category": "meta",
 "summary": "The Profile page (avatar, name, stats) with the Edit Profile (avatar grid) and Username popups.",
 "description": "Screen.profile, opened by the home avatar: the page header, the player card (avatar -> Edit Profile, the name -> Username), the stats. EditProfilePopup writes the avatar, UsernamePopup validates and writes the name (3-16 characters, blocklists), both through PlayerStore.",
 "status": "stable",
 "files": [
  "apps/mazeout/App/Shell/Profile/ProfileView.swift",
  "apps/mazeout/App/Shell/Popups/EditProfilePopup.swift",
  "apps/mazeout/App/Shell/Popups/UsernamePopup.swift"
 ],
 "depends": [
  "core",
  "avatars",
  "ui-chrome"
 ],
 "wires": [
  "shop",
  "balloon-rise"
 ],
 "uses": {
  "art": [
   "event.clawChallenge.token",
   "event.rocketRace.racerMine",
   "event.skyJump.icon",
   "icon.checkBadge",
   "icon.pencil",
   "profile.stat.firstTry",
   "profile.stat.weeklyWins",
   "social.scoreChip"
  ],
  "strings": [
   "Cloud Hop Wins",
   "Continue",
   "Create your username:",
   "Edit Profile",
   "First Try Wins",
   "General Stats",
   "Hot Streak Wins",
   "Level",
   "Name must be 2-16 characters",
   "Name must be 3-16 characters",
   "Profile",
   "Rocket Rally Wins",
   "Save",
   "This name is not allowed",
   "Treasure Climb Wins",
   "Up & Away Best Streak",
   "Username",
   "Weekly Cup Wins"
  ],
  "tuning": [
   "ui.json:colors.page"
  ],
  "skinTokens": [
   "popups.editProfilePopup",
   "popups.usernamePopup",
   "profile.profileView"
  ]
 },
 "launchArgs": [
  "-pc.go profile",
  "-pc.go profile -pc.popup editProfile",
  "-pc.go profile -pc.popup username"
 ]
}
