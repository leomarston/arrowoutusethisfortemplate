# This Mac's devices and tool paths, read by the dev tools (never secrets: those live in .env).
# Copy to machine.env (git-ignored) and edit:   cp machine.env.example machine.env
# An environment variable of the same name always wins over this file.
# The values below are the ORIGINAL owner's Mac; on any other Mac, replace them.

# Two dedicated iPhone simulators, one per build "slot" (tools/slot.sh A|B), so two agents never share one.
# Create them once:  xcrun simctl create "Game A" "iPhone 16" <runtime>   (xcrun simctl list runtimes)
SIM_A_UDID=177520B6-4889-46C2-BDD9-155813D2B175
SIM_A_NAME=Maze A
SIM_B_UDID=B80EDB24-6280-4C52-A63F-E8AADD245017
SIM_B_NAME=Maze B

# The USB iPhone used for research (tools/phonedriver) and phone builds (apps/<slug>/tools/owner-phone.sh).
# PHONE_UDID: xcrun xctrace list devices  ·  PHONE_DEVICE (CoreDevice id): xcrun devicectl list devices
PHONE_UDID=00008120-000964E426440032
PHONE_DEVICE=878DB538-F187-596F-B24B-EAF8853617DE

# Optional tool paths (default: found on PATH).
# XCODEGEN=/Users/you/.local/bin/xcodegen
# ART_PY=/Users/you/.venvs/mf3d/bin/python
