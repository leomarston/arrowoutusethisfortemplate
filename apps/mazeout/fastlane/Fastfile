default_platform(:ios)

# .env repo kökünde; fastlane app dizininden çalışır — iki üst dizinden yükle.
require "dotenv"
require "shellwords"
Dotenv.load(File.expand_path("../../../.env", __dir__))

# gym runs xcodebuild with this process's environment, and Xcode exports every environment variable as a build setting
# (into every script phase, and into a verbose log). The lanes still need some secrets themselves (the Apple web session
# for create_app / upload_privacy, the ASC key for deliver), so they are hidden only while gym builds, then restored.
BUILD_SECRET_KEYS = %w[META_CLIENT_TOKEN RC_SECRET_KEY GEMINI_API_KEY FASTLANE_SESSION FASTLANE_PASSWORD
                       ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH REVIEW_PHONE REVIEW_EMAIL].freeze
def without_build_secrets
  saved = BUILD_SECRET_KEYS.to_h { |k| [k, ENV.delete(k)] }
  yield
ensure
  saved.each { |k, v| ENV[k] = v unless v.nil? }
end

# Two "Apple Distribution: ..." identities can exist in the search list at once (a stale
# cert plus the live one). Resolving by NAME then picks arbitrarily, and codesign fails with
# errSecInternalComponent. Pin the exact certificate that keys/signing/dist.cer holds —
# it is by definition the one embedded in the profile signing_setup.py just installed.
def dist_cert_sha1
  cer = File.expand_path("../../../keys/signing/dist.cer", __dir__)
  return "Apple Distribution" unless File.exist?(cer)
  out = `openssl x509 -in #{Shellwords.escape(cer)} -inform DER -noout -fingerprint -sha1 2>/dev/null`
  sha = out.split("=").last.to_s.strip.delete(":")
  sha.empty? ? "Apple Distribution" : sha
end

def regenerate_project
  # The .xcodeproj is gitignored and generated by xcodegen, so it can lag the working tree.
  # On tvremote this shipped as a near-miss: nine localized .lproj folders existed on disk
  # while the project still declared knownRegions = (Base, en), so the archive would have been
  # English-only with every translation sitting unused in the repo. Regenerate before archiving.
  root = File.expand_path("..", __dir__)
  # Arrow Out: always through tools/gen.sh (a mutex; it also runs the knownRegions postGenCommand).
  Dir.chdir(root) { sh("sh tools/gen.sh") }
end

def unlock_signing_keychain
  # The dedicated signing keychain re-locks on sleep, and signing_setup.py may have unlocked it
  # an hour before the archive finishes — gym then dies in EXPORT with errSecInternalComponent
  # while its own log ends in "ARCHIVE SUCCEEDED". Unlock inside the lane, every time.
  root = File.expand_path("../../..", __dir__)
  kc   = File.expand_path("~/Library/Keychains/manycode-signing.keychain-db")
  pass_file = File.join(root, "keys", "signing", "keychain.pass")
  return unless File.exist?(pass_file) && File.exist?(kc)
  pw = File.read(pass_file).strip
  system("security", "unlock-keychain", "-p", pw, kc)
  system("security", "set-key-partition-list", "-S", "apple-tool:,apple:,codesign:",
         "-s", "-k", pw, kc, out: File::NULL, err: File::NULL)
end

# No ad / attribution SDK in the template (docs/ROADMAP.md D2), so the version declares no IDFA use. A game that adds one
# must run `scripts/asc_submit.py --uses-idfa` (deliver ignores every add_id_info_* key; docs/recipes/ad-attribution.md).
SUBMISSION_INFO = { export_compliance_uses_encryption: false }.freeze

# RFIX 2026-09-29 (VERIFY F4, SPEC ruling 55(b)): the store IPA carries NO dSYM (gym include_symbols false + uploadSymbols
# false: FIX-3 counted the build tree's path 2,110 times in the dSYM) and its binary carries no 'mazeout' in `strings -a` or
# `nm`. The archive (with its dSYM) stays in ~/Library/Developer/Xcode/Archives for local symbolication.
def ipa_provenance_clean!(ipa)
  raise "no IPA at #{ipa}" unless ipa && File.exist?(ipa)
  listing = `unzip -Z1 #{Shellwords.escape(ipa)}`
  syms = listing.lines.map(&:strip).select { |l| l.start_with?("Symbols/") || l.include?(".dSYM/") }
  UI.user_error!("the IPA carries symbols (#{syms.first(3).join(', ')}): ruling 55(b) wants a dSYM-less IPA") unless syms.empty?
  require "tmpdir"
  Dir.mktmpdir do |d|
    sh("unzip -q -o #{Shellwords.escape(ipa)} 'Payload/ArrowOut.app/ArrowOut' -d #{Shellwords.escape(d)}", log: false)
    bin = File.join(d, "Payload", "ArrowOut.app", "ArrowOut")
    hits = `strings -a #{Shellwords.escape(bin)} | grep -ci mazeout`.to_i + `nm -a #{Shellwords.escape(bin)} 2>/dev/null | grep -ci mazeout`.to_i
    UI.user_error!("the IPA's binary names 'mazeout' #{hits} time(s) (strings -a + nm): not uploading") unless hits.zero?
    UI.success("provenance: no dSYM in the IPA; 0 'mazeout' in the binary's strings -a and nm")
  end
end

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"), File.expand_path("../../..", __dir__))
  )
end

platform :ios do
  desc "App Store Connect'te app kaydını oluştur"
  lane :create_app do
    asc_key  # token'ı lane context'e koyar; produce oradan okur (api_key parametresi yok)
    produce(
      app_identifier: "com.manycode.arrowout",
      app_name: "Arrow Out: Arrow Escape Puzzle",
      language: "en-US",
      app_version: "1.0.0",
      sku: "arrowout-#{Time.now.to_i}"
    )
  end

  desc "Archive + upload + metadata + screenshots (does NOT submit: scripts/asc_submit.py does)"
  lane :release do
    unlock_signing_keychain
    regenerate_project
    key = asc_key
    # Cihazsiz imzalama (scripts/signing_setup.py once calismis olmali):
    # arsiv imzasiz alinir, imza export'ta manual profille atilir. Cloud signing
    # (Admin key) ve kayitli cihaz gerektirmez.
    without_build_secrets do gym(
      scheme: "ArrowOut",
      export_method: "app-store",
      xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO",
      export_options: {
        signingStyle: "manual",
        signingCertificate: dist_cert_sha1,
        teamID: ENV.fetch("TEAM_ID"),
        provisioningProfiles: { "com.manycode.arrowout" => "manycode arrowout appstore" },
        uploadSymbols: false
      },
      output_directory: "build",
      include_symbols: false,   # RFIX (ruling 55(b), VERIFY F4): a dSYM-less IPA; the archive keeps the dSYM locally
      clean: true
    ) end
    ipa_provenance_clean!(lane_context[SharedValues::IPA_OUTPUT_PATH])
    # App Privacy (nutrition label): ilk submit icin zorunlu, yoksa ASC reddeder.
    # JSON, PrivacyInfo.xcprivacy ile tutarli: only Purchase History (RevenueCat), not linked, no tracking.
    # DIKKAT: Bu action ASC API key DEGIL Apple ID oturumu kullanir (2FA isteyebilir);
    # JSON semasini ilk kosuda ASC'de dogrula.
    # Privacy details need an interactive Apple ID password; they only need to be
    # set once per app. SKIP_PRIVACY=1 skips it on re-releases.
    unless ENV["SKIP_PRIVACY"]
      upload_app_privacy_details_to_app_store(
        app_identifier: "com.manycode.arrowout",
        username: ENV.fetch("APPLE_ID"),
        json_path: "./fastlane/metadata/app_privacy_details.json"
      )
    end
    deliver(
      api_key: key,
      app_identifier: "com.manycode.arrowout",
      submit_for_review: false,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      submission_information: SUBMISSION_INFO.dup
    )
  end

  desc "SADECE App Privacy (nutrition label) yukle — release'i upload_meta+upload_build'e boldugunde SART"
  lane :upload_privacy do
    # Bu adim normalde release lane'inin ICINDE. release'i parcalara bolunce atlanir ve
    # yalnizca submit aninda APP_DATA_USAGES_REQUIRED olarak patlar — yani en sonda.
    # ASC API key DEGIL Apple ID oturumu kullanir (2FA isteyebilir).
    upload_app_privacy_details_to_app_store(
      app_identifier: "com.manycode.arrowout",
      username: ENV.fetch("APPLE_ID"),
      json_path: "./fastlane/metadata/app_privacy_details.json"
    )
  end

  desc "Sadece binary yukle (revizyon) — metadata/screenshot'a dokunmaz"
  lane :upload_build do
    unlock_signing_keychain
    regenerate_project
    key = asc_key
    without_build_secrets do gym(
      scheme: "ArrowOut",
      export_method: "app-store",
      xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO",
      export_options: {
        signingStyle: "manual",
        signingCertificate: dist_cert_sha1,
        teamID: ENV.fetch("TEAM_ID"),
        provisioningProfiles: { "com.manycode.arrowout" => "manycode arrowout appstore" },
        uploadSymbols: false
      },
      output_directory: "build",
      include_symbols: false,   # RFIX (ruling 55(b), VERIFY F4): a dSYM-less IPA; the archive keeps the dSYM locally
      clean: true
    ) end
    ipa_provenance_clean!(lane_context[SharedValues::IPA_OUTPUT_PATH])
    deliver(
      api_key: key,
      app_identifier: "com.manycode.arrowout",
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: SUBMISSION_INFO.dup
    )
  end

  desc "Sadece metadata + screenshot güncelle (binary yok)"
  lane :upload_meta do
    deliver(
      api_key: asc_key,
      app_identifier: "com.manycode.arrowout",
      skip_binary_upload: true,
      precheck_include_in_app_purchases: false,
      # Yeniden yuklemede eskileri sil — yoksa ASC'de mukerrer screenshot birikir.
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end

  desc "SADECE metadata (screenshot YOK, binary YOK) — deliver bu makinede screenshot yukleyemiyor"
  lane :upload_meta_only do
    # `upload_meta` screenshot'lari da iter ve bu makinede deliver'in screenshot cagrilari
    # her seferinde `SSL_read: unexpected eof` ile olur ([[deliver-cannot-upload-screenshots]]).
    # Metni guncellemek icin bu lane, gorselleri icin scripts/asc_screenshots.py.
    deliver(
      api_key: asc_key,
      app_identifier: "com.manycode.arrowout",
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      force: true
    )
  end

  desc "SADECE screenshot yukle — metadata/keywords'a DOKUNMAZ"
  lane :upload_shots do
    deliver(
      api_key: asc_key,
      app_identifier: "com.manycode.arrowout",
      skip_binary_upload: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end

end
