{
  "sourceLanguage" : "en",
  "strings" : {
    "NSUserTrackingUsageDescription" : {
      "comment" : "META (OWNER 2026-09-29 19:33): the ATT purpose string (the system alert's body under iOS's own 'Allow … to track your activity' title). Neutral: describes, never urges; no brand (iOS names the app). EN must equal project.yml info: NSUserTrackingUsageDescription.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta nutzt dies, um uns zu zeigen, welche unserer Anzeigen dich zum Spiel gebracht hat, damit wir diese Anzeigen verbessern können. Das Spiel funktioniert in beiden Fällen gleich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta uses this to tell us which of our ads brought you to the game, so we can improve those ads. The game works the same either way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta lo usa para decirnos cuál de nuestros anuncios te trajo al juego, para que podamos mejorarlos. El juego funciona igual en ambos casos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta s'en sert pour nous indiquer laquelle de nos publicités t'a fait découvrir le jeu, afin que nous puissions les améliorer. Le jeu fonctionne de la même façon dans les deux cas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta lo usa per dirci quale dei nostri annunci ti ha portato al gioco, così possiamo migliorarli. Il gioco funziona allo stesso modo in entrambi i casi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metaはこれを使って、どの広告からこのゲームに来たかを私たちに知らせます。広告の改善に役立てるためです。どちらを選んでもゲームの動作は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta는 이를 통해 어떤 광고를 보고 게임에 오셨는지 알려 주며, 저희는 이를 광고 개선에 활용합니다. 어떤 선택을 하셔도 게임은 똑같이 작동합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta używa tego, aby przekazać nam, która z naszych reklam przyprowadziła cię do gry, dzięki czemu możemy je ulepszać. Gra działa tak samo niezależnie od wyboru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Meta usa isso para nos dizer qual dos nossos anúncios trouxe você ao jogo, para podermos melhorá-los. O jogo funciona do mesmo jeito em qualquer caso."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta to používa na to, aby nám povedala, ktorá z našich reklám ťa priviedla do hry, aby sme ich mohli zlepšovať. Hra funguje rovnako v oboch prípadoch."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta s tem sporoči, kateri od naših oglasov te je pripeljal do igre, da lahko te oglase izboljšamo. Igra deluje enako ne glede na izbiro."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta bunu, seni oyuna reklamlarımızdan hangisinin getirdiğini bize bildirmek için kullanır; böylece bu reklamları geliştirebiliriz. Seçimin ne olursa olsun oyun aynı şekilde çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meta会借此告诉我们你是通过哪条广告来到游戏的，以便我们改进这些广告。无论你如何选择，游戏都照常运行。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
