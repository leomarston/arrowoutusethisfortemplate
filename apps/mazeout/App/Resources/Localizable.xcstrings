    "The game is provided as is. We may update the game and these terms." : {
      "comment" : "GP §16.10 Terms ¶5",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel wird ohne Gewähr bereitgestellt. Wir können das Spiel und diese Bedingungen aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game is provided as is. We may update the game and these terms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego se ofrece tal cual. Podemos actualizar el juego y estos términos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu est fourni en l'état. Nous pouvons mettre à jour le jeu et ces conditions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gioco è fornito così com'è. Potremmo aggiornare il gioco e questi termini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本ゲームは現状のまま提供されます。ゲームおよび本規約は更新されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임은 있는 그대로 제공됩니다. 게임과 본 약관은 업데이트될 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gra jest udostępniana w stanie „takim, jaki jest”. Możemy aktualizować grę i niniejsze warunki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo é fornecido no estado em que se encontra. Podemos atualizar o jogo e estes termos."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hra sa poskytuje tak, ako je. Hru a tieto podmienky môžeme aktualizovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
