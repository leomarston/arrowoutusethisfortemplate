    "Starting a level uses a life; winning gives it back. A new life arrives every 30 minutes." : {
      "comment" : "SHELL request: SHELL S1: Support page body (SPEC-ui §2.13.1; SPEC-gameplay §8.1: taken at start, refunded on a win, 1800 s)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Level zu starten kostet ein Leben; gewinnst du, bekommst du es zurück. Alle 30 Minuten kommt ein neues Leben dazu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starting a level uses a life; winning gives it back. A new life arrives every 30 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezar un nivel gasta una vida; si ganas, la recuperas. Recibes una vida nueva cada 30 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancer un niveau coûte une vie ; la victoire te la rend. Une nouvelle vie arrive toutes les 30 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniziare un livello costa una vita; se vinci, la riavrai. Ogni 30 minuti arriva una nuova vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レベルを始めるとライフを1つ使いますが、クリアすると戻ってきます。ライフは30分ごとに1つ回復します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레벨을 시작하면 생명이 하나 사용되고, 승리하면 돌려받아요. 30분마다 새 생명이 생겨요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoczęcie poziomu kosztuje życie; wygrana je zwraca. Nowe życie pojawia się co 30 minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começar um nível gasta uma vida; se você vencer, ela volta. Uma nova vida chega a cada 30 minutos."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustenie úrovne stojí jeden život; výhra ti ho vráti. Nový život pribudne každých 30 minút."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začetek stopnje porabi eno življenje; zmaga ti ga vrne. Novo življenje pride vsakih 30 minut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir seviyeye başlamak bir can harcar; kazanınca geri gelir. Her 30 dakikada bir yeni can gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始一个关卡会消耗一条生命，获胜后返还。每30分钟恢复一条生命。"
          }
        }
      }
    },
