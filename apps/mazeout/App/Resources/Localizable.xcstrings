    "Coins, lives, boosters and other items in the game have no money value and cannot be exchanged or refunded outside the game." : {
      "comment" : "GP §16.10 Terms ¶2",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Münzen, Leben, Booster und andere Gegenstände im Spiel haben keinen Geldwert und können außerhalb des Spiels weder getauscht noch erstattet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coins, lives, boosters and other items in the game have no money value and cannot be exchanged or refunded outside the game."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las monedas, vidas, potenciadores y demás objetos del juego no tienen valor monetario y no pueden canjearse ni reembolsarse fuera del juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces, vies, boosters et autres objets du jeu n'ont aucune valeur monétaire et ne peuvent être ni échangés ni remboursés en dehors du jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monete, vite, potenziamenti e altri oggetti del gioco non hanno valore monetario e non possono essere scambiati o rimborsati fuori dal gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム内のコイン、ライフ、ブースター、その他のアイテムに金銭的価値はなく、ゲーム外での交換や払い戻しはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게임 내 코인, 생명, 부스터 및 기타 아이템은 금전적 가치가 없으며 게임 밖에서 교환하거나 환불할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monety, życia, wzmacniacze i inne przedmioty w grze nie mają wartości pieniężnej i nie można ich wymienić ani zwrócić poza grą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moedas, vidas, reforços e outros itens do jogo não têm valor em dinheiro e não podem ser trocados nem reembolsados fora do jogo."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mince, životy, bonusy a ďalšie predmety v hre nemajú peňažnú hodnotu a mimo hry ich nemožno vymeniť ani refundovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kovanci, življenja, pomočki in drugi predmeti v igri nimajo denarne vrednosti in jih zunaj igre ni mogoče zamenjati ali vrniti za denar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyundaki altınların, canların, güçlendiricilerin ve diğer öğelerin parasal değeri yoktur; oyun dışında değiştirilemez veya iade edilemez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏中的金币、生命、道具及其他物品不具有货币价值，不能在游戏外兑换或退款。"
          }
        }
      }
    },
