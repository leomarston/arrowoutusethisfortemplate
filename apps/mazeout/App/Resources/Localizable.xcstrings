    "%@ has no accounts and shows no ads." : {
      "comment" : "META (OWNER 2026-09-29 19:33, the Meta SDK in 1.0): was '%@ has no accounts, no ads and no tracking.' — 'no tracking' became false; keeps what stays true (no accounts, no ads shown in the game). Privacy page ¶1 (%@ = Brand.name). TR/l10n: META draft",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keine Konten und zeigt keine Werbung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has no accounts and shows no ads."
          }
        },
