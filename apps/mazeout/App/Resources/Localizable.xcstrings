    "Purchases are made through Apple and follow the App Store terms. We never see your payment details." : {
      "comment" : "GP §16.10 Terms ¶3",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käufe laufen über Apple und unterliegen den Bedingungen des App Store. Deine Zahlungsdaten sehen wir nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchases are made through Apple and follow the App Store terms. We never see your payment details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las compras se hacen a través de Apple y siguen las condiciones de App Store. Nunca vemos tus datos de pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les achats passent par Apple et suivent les conditions de l'App Store. Nous ne voyons jamais tes informations de paiement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli acquisti avvengono tramite Apple e seguono i termini dell'App Store. Non vediamo mai i tuoi dati di pagamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入はAppleを通じて行われ、App Storeの規約に従います。お支払い情報を私たちが見ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매는 Apple을 통해 이루어지며 App Store 약관을 따릅니다. 당사는 결제 정보를 절대 볼 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakupy odbywają się przez Apple i podlegają warunkom App Store. Nigdy nie widzimy twoich danych płatniczych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As compras são feitas pela Apple e seguem os termos da App Store. Nunca vemos seus dados de pagamento."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nákupy prebiehajú cez Apple a riadia sa podmienkami App Store. Tvoje platobné údaje nikdy nevidíme."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakupi potekajo prek podjetja Apple in zanje veljajo pogoji trgovine App Store. Tvojih plačilnih podatkov nikoli ne vidimo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satın almalar Apple üzerinden yapılır ve App Store koşullarına tabidir. Ödeme bilgilerini asla görmeyiz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买通过Apple进行，并遵守App Store条款。我们绝不会看到你的支付信息。"
          }
        }
      }
    },
