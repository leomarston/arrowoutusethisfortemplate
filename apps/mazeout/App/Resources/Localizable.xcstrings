            "state" : "translated",
            "value" : "%@にはアカウントがなく、広告も表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 계정이 없으며 광고도 표시되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie ma kont i nie wyświetla reklam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
