# Copy this file to .env (same folder, the repo root) and fill in the values:  cp .env.example .env
# .env is git-ignored. Never commit it, never paste its values into any other file.
# Format: KEY=value, one per line, no spaces around "=". Quotes are optional.
# Read by: scripts/*.py (their own env() parser), scripts/*.sh and tools/phonedriver/start-runner (`source .env`),
# apps/<slug>/fastlane/Fastfile + Appfile (dotenv, loads ../../../.env), apps/mazeout/tools/meta_token.py (Meta token only).

# ---- Apple / App Store Connect ----
# Apple ID e-mail of the developer account holder. Used by fastlane for Apple-ID-session steps (create_app, upload_privacy).
APPLE_ID=
# 10-character Team ID. developer.apple.com > Account > Membership details.
TEAM_ID=
# Optional: App Store Connect team id, only if the Apple ID belongs to several ASC teams. Keep the line commented out when
# unused: the Appfile tests `if ENV["ITC_TEAM_ID"]`, and in Ruby an EMPTY value still counts as set (docs/lessons/empty-env-var-is-truthy.md).
# ITC_TEAM_ID=
# App Store Connect API key id. appstoreconnect.apple.com > Users and Access > Integrations > App Store Connect API (role: App Manager is enough).
ASC_KEY_ID=
# Issuer ID shown at the top of that same API keys page.
ASC_ISSUER_ID=
# Path to the downloaded AuthKey_<ASC_KEY_ID>.p8, relative to the repo root (e.g. keys/AuthKey_XXXXXXXXXX.p8) or absolute / ~/...
# Put the file in keys/ (git-ignored). Apple lets you download it only once.
ASC_KEY_PATH=

# ---- Identity used by the factory scripts ----
# Reverse-DNS prefix for bundle ids (e.g. com.yourbrand). Scripts build <prefix>.<slug> unless given --bundle.
BUNDLE_PREFIX=
# Developer / seller name written into a new app's metadata by scripts/new_app.sh.
DEV_NAME=
# Public privacy-policy URL (scripts/new_app.sh, scripts/fill_locale_urls.py). A game with the Meta SDK needs its own page.
PRIVACY_URL=
# Public support URL (same scripts).
SUPPORT_URL=
# App Review contact, written into fastlane/metadata/review_information/ by scripts/new_app.sh.
REVIEW_FIRST_NAME=
REVIEW_LAST_NAME=
# Phone with country code, e.g. +90...
REVIEW_PHONE=
REVIEW_EMAIL=

# ---- RevenueCat ----
# Project id (starts with proj). app.revenuecat.com > Project settings. The factory uses ONE shared project for all apps.
RC_PROJECT_ID=
# SECRET API key, v2 (starts with sk_). app.revenuecat.com > Project > API keys > + New secret key. Never ship it in an app.
RC_SECRET_KEY=

# ---- Google Gemini (optional) ----
# Image generation for scripts/gen_image.py only. aistudio.google.com > Get API key.
GEMINI_API_KEY=

# ---- Meta (Facebook) install attribution ----
# The app's CLIENT token (32 lowercase hex), NOT the App Secret. developers.facebook.com > your app > App settings > Advanced >
# Security > Client token. tools/meta_token.py writes it into the BUILT Info.plist only; a Release/Measure build fails without it.
META_CLIENT_TOKEN=

# ---- Optional ----
# Apple web session for headless fastlane create_app / upload_privacy. Produced by `fastlane spaceauth -u <APPLE_ID>`
# (password + 2FA); it expires after ~30 days. Leave it out unless you really need unattended runs.
# FASTLANE_SESSION=
# USB iPhone UDID for tools/phonedriver/start-runner (it has the owner's phone as a built-in default). `xcrun devicectl list devices`.
# PHONE_UDID=
